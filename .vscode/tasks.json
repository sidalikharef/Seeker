{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "seeker: build",
      "type": "shell",
      "command": "pnpm build",
      "problemMatcher": "$tsc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "seeker: watch",
      "type": "shell",
      "command": "pnpm watch",
      "isBackground": true,
      "problemMatcher": "$tsc-watch"
    }
  ]
}
